{
  "name": "@heydeacon/docusaurus-plugin",
  "version": "1.0.0",
  "description": "Docusaurus plugin that adds Deacon, an AI support chat that answers from your docs, to every page.",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "deacon",
    "chat widget",
    "support",
    "ai",
    "chatbot",
    "ai-chatbot",
    "ask-ai",
    "support-chat"
  ],
  "homepage": "https://heydeacon.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heydeacon/docusaurus-plugin-deacon.git"
  },
  "author": "Deacon <hello@heydeacon.com> (https://heydeacon.com)",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
